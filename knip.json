{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/sdk.ts",
    "src/job-runner.ts",
    "src/job-supervisor.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/tui/__benchmarks__/*.ts",
    "src/tui/__benchmarks__/*.tsx",
    "scripts/*.ts",
    "scripts/*.mjs",
    ".claude/skills/run-book/*.mjs",
    "*.config.ts"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"],
  "ignoreBinaries": ["rg", "wsl.exe"]
}
