{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-harness-report-v2",
  "title": "Book Phase 0 Evaluation Report v2",
  "oneOf": [{ "$ref": "#/$defs/calibrationReport" }, { "$ref": "#/$defs/confirmatoryReport" }],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "rawOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "taskFailure",
        "budgetExhaustion",
        "agentRuntimeFailure",
        "timeout",
        "requiredArtifactMissing",
        "executionCancelled",
        "userCancelled",
        "unknown",
        "missingOutcome",
        "evaluatorFailure",
        "setupFailure",
        "comparisonIdentityFailure",
        "evaluatorIntegrityFailure",
        "cleanupFailure"
      ],
      "properties": {
        "success": { "$ref": "#/$defs/nonNegativeInteger" },
        "taskFailure": { "$ref": "#/$defs/nonNegativeInteger" },
        "budgetExhaustion": { "$ref": "#/$defs/nonNegativeInteger" },
        "agentRuntimeFailure": { "$ref": "#/$defs/nonNegativeInteger" },
        "timeout": { "$ref": "#/$defs/nonNegativeInteger" },
        "requiredArtifactMissing": { "$ref": "#/$defs/nonNegativeInteger" },
        "executionCancelled": { "$ref": "#/$defs/nonNegativeInteger" },
        "userCancelled": { "$ref": "#/$defs/nonNegativeInteger" },
        "unknown": { "$ref": "#/$defs/nonNegativeInteger" },
        "missingOutcome": { "$ref": "#/$defs/nonNegativeInteger" },
        "evaluatorFailure": { "$ref": "#/$defs/nonNegativeInteger" },
        "setupFailure": { "$ref": "#/$defs/nonNegativeInteger" },
        "comparisonIdentityFailure": { "$ref": "#/$defs/nonNegativeInteger" },
        "evaluatorIntegrityFailure": { "$ref": "#/$defs/nonNegativeInteger" },
        "cleanupFailure": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "armOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armId",
        "role",
        "assigned",
        "intentionToTreatDenominator",
        "raw",
        "initialFixtureLedgerDigest",
        "finalSnapshotLedgerDigest",
        "rawOutcomeLedgerDigest"
      ],
      "properties": {
        "armId": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["baseline", "candidate"] },
        "assigned": { "$ref": "#/$defs/nonNegativeInteger" },
        "intentionToTreatDenominator": { "$ref": "#/$defs/nonNegativeInteger" },
        "raw": { "$ref": "#/$defs/rawOutcomes" },
        "initialFixtureLedgerDigest": { "$ref": "#/$defs/digest" },
        "finalSnapshotLedgerDigest": { "$ref": "#/$defs/digest" },
        "rawOutcomeLedgerDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "margin", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unknown", "not-applicable"] },
        "margin": { "type": "number" },
        "plannedPower": { "type": "number", "minimum": 0, "maximum": 1 },
        "achievedPower": { "type": "number", "minimum": 0, "maximum": 1 },
        "adjustedAlpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
        "adjustedBound": { "type": "number" },
        "observedDelta": { "type": "number" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "not": { "const": "not-applicable" } } } },
          "then": { "required": ["plannedPower", "adjustedAlpha"] }
        }
      ]
    },
    "passedGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "required": [
            "plannedPower",
            "achievedPower",
            "adjustedAlpha",
            "adjustedBound",
            "observedDelta"
          ],
          "properties": {
            "status": { "const": "passed" },
            "plannedPower": { "minimum": 0.8 },
            "achievedPower": { "minimum": 0.8 }
          }
        }
      ]
    },
    "compatibilityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "canonicalValue", "source", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["locked-equal", "treatment", "stratifier", "diagnostic"] },
        "canonicalValue": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sliceDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "sliceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "hypothesisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesisId",
        "status",
        "holmRank",
        "adjustedAlpha",
        "adjustedIntervalLower",
        "adjustedIntervalUpper"
      ],
      "properties": {
        "hypothesisId": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["passed", "failed", "unknown"] },
        "holmRank": { "type": "integer", "minimum": 1 },
        "adjustedAlpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
        "adjustedIntervalLower": { "type": "number", "minimum": -1, "maximum": 1 },
        "adjustedIntervalUpper": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "attestationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectDigest", "statementDigest", "signerId", "verified"],
      "properties": {
        "subjectDigest": { "$ref": "#/$defs/digest" },
        "statementDigest": { "$ref": "#/$defs/digest" },
        "signerId": { "$ref": "#/$defs/nonEmptyString" },
        "verified": { "type": "boolean" }
      }
    },
    "confirmationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluatorReleaseDigest",
        "evaluatorProvenanceDigest",
        "analysisDigest",
        "reportSchemaDigest",
        "workerRegistrationDigest",
        "brokerDigest",
        "verifierReleaseDigests",
        "corpusVersion",
        "corpusDigest",
        "splitVersion",
        "splitDigest",
        "splitRole",
        "compatibilityCellDigest"
      ],
      "properties": {
        "evaluatorReleaseDigest": { "$ref": "#/$defs/digest" },
        "evaluatorProvenanceDigest": { "$ref": "#/$defs/digest" },
        "analysisDigest": { "$ref": "#/$defs/digest" },
        "reportSchemaDigest": { "$ref": "#/$defs/digest" },
        "workerRegistrationDigest": { "$ref": "#/$defs/digest" },
        "brokerDigest": { "$ref": "#/$defs/digest" },
        "verifierReleaseDigests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/digest" }
        },
        "corpusVersion": { "$ref": "#/$defs/nonEmptyString" },
        "corpusDigest": { "$ref": "#/$defs/digest" },
        "splitVersion": { "$ref": "#/$defs/nonEmptyString" },
        "splitDigest": { "$ref": "#/$defs/digest" },
        "splitRole": { "const": "promotion-sealed" },
        "compatibilityCellDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "confirmatoryDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "designClass",
        "preregistrationId",
        "preregistrationDigest",
        "lockedAt",
        "lockedBeforeTargetOutcomes",
        "targetPopulation",
        "exactSlice",
        "identity",
        "candidate",
        "baseline",
        "hypotheses",
        "multiplicityFamilyId",
        "queryBudget",
        "retryBudget",
        "estimand",
        "plannedIndependentFamilies",
        "plannedRepetitionsPerFamily",
        "plannedEnrolledBlocks",
        "plannedPower",
        "practicalEffect",
        "metricPolicyDigest",
        "guardrailPolicyDigest",
        "budgetPolicyDigest",
        "familyWiseAlpha",
        "multiplicity",
        "horizon",
        "stoppingRule",
        "randomizationScheduleDigest",
        "exclusionRulesDigest",
        "queryLedgerDigest",
        "thresholdsMayRelaxAfterOutcomes"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "designClass": { "const": "confirmatory" },
        "preregistrationId": { "$ref": "#/$defs/nonEmptyString" },
        "preregistrationDigest": { "$ref": "#/$defs/digest" },
        "lockedAt": { "type": "string", "format": "date-time" },
        "lockedBeforeTargetOutcomes": { "const": true },
        "targetPopulation": { "$ref": "#/$defs/nonEmptyString" },
        "exactSlice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerOriginAdapterModel",
            "taskClass",
            "projectRisk",
            "outcomeClass",
            "fixtureAuthority",
            "agentClass",
            "network"
          ],
          "properties": {
            "providerOriginAdapterModel": { "$ref": "#/$defs/nonEmptyString" },
            "taskClass": { "const": "multi-file" },
            "projectRisk": { "const": "medium" },
            "outcomeClass": { "const": "machine-verifiable" },
            "fixtureAuthority": { "const": "evaluator-owned-data-only" },
            "agentClass": { "const": "trusted-built-in-single-agent" },
            "network": { "const": "off-provider-broker-only" }
          }
        },
        "identity": { "$ref": "#/$defs/confirmationIdentity" },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflowDigest", "adaptiveParameters"],
          "properties": {
            "workflowDigest": { "$ref": "#/$defs/digest" },
            "adaptiveParameters": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflowDigest", "strongestEligible", "selectionEvidence"],
          "properties": {
            "workflowDigest": { "$ref": "#/$defs/digest" },
            "strongestEligible": { "const": true },
            "selectionEvidence": { "enum": ["held-in", "nested-validation"] }
          }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hypothesis" }
        },
        "multiplicityFamilyId": { "$ref": "#/$defs/nonEmptyString" },
        "queryBudget": { "type": "integer", "minimum": 1 },
        "retryBudget": { "$ref": "#/$defs/nonNegativeInteger" },
        "estimand": {
          "const": "paired-itt-success-difference-vs-strongest-eligible-fixed-baseline"
        },
        "plannedIndependentFamilies": { "type": "integer", "minimum": 20 },
        "plannedRepetitionsPerFamily": { "type": "integer", "minimum": 5 },
        "plannedEnrolledBlocks": { "type": "integer", "minimum": 1 },
        "plannedPower": { "type": "number", "minimum": 0.8, "maximum": 1 },
        "practicalEffect": { "type": "number", "minimum": 0.15, "maximum": 1 },
        "metricPolicyDigest": { "$ref": "#/$defs/digest" },
        "guardrailPolicyDigest": { "$ref": "#/$defs/digest" },
        "budgetPolicyDigest": { "$ref": "#/$defs/digest" },
        "familyWiseAlpha": { "const": 0.05 },
        "multiplicity": { "const": "holm" },
        "horizon": { "const": "fixed" },
        "stoppingRule": { "$ref": "#/$defs/nonEmptyString" },
        "randomizationScheduleDigest": { "$ref": "#/$defs/digest" },
        "exclusionRulesDigest": { "$ref": "#/$defs/digest" },
        "queryLedgerDigest": { "$ref": "#/$defs/digest" },
        "thresholdsMayRelaxAfterOutcomes": { "const": false }
      }
    },
    "calibrationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "designClass",
        "claimAuthority",
        "corpusVersion",
        "corpusDigest",
        "splitRole",
        "evaluatorVersion",
        "evaluatorReleaseStatus",
        "generatedAt",
        "attemptsPerArm",
        "repeatedControlRuns",
        "attempts",
        "noiseSummary",
        "disposition",
        "limitations"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "designClass": { "const": "calibration" },
        "claimAuthority": { "const": "none" },
        "corpusVersion": { "const": "calibration-public-v1" },
        "corpusDigest": { "$ref": "#/$defs/digest" },
        "splitRole": { "const": "calibration-public" },
        "evaluatorVersion": { "$ref": "#/$defs/nonEmptyString" },
        "evaluatorReleaseStatus": { "const": "unpackaged-calibration-source" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "attemptsPerArm": { "const": 3 },
        "repeatedControlRuns": { "const": 5 },
        "attempts": { "type": "array", "minItems": 1, "items": {} },
        "noiseSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sampleCount", "successRate", "unknownRate", "setupFailureRate"],
          "properties": {
            "sampleCount": { "$ref": "#/$defs/nonNegativeInteger" },
            "successRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "unknownRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "setupFailureRate": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "disposition": { "const": "calibration-only" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "confirmatoryReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "designClass",
        "claimAuthority",
        "generatedAt",
        "design",
        "campaign",
        "outcomesByArm",
        "infrastructure",
        "aaEvidence",
        "inference",
        "multiplicity",
        "guardrails",
        "executionDiagnostics",
        "compatibility",
        "integrity",
        "attestations",
        "approval",
        "limitations",
        "unsupportedSlices",
        "evidenceStartedAt",
        "evidenceCompletedAt",
        "evidenceExpiresAt",
        "revalidationTriggers",
        "rollbackTargetDigest",
        "disposition",
        "dispositionReasons"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "designClass": { "const": "confirmatory" },
        "claimAuthority": { "const": "promotion-eligible" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "design": { "$ref": "#/$defs/confirmatoryDesign" },
        "campaign": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enrolledBlocks",
            "completedBlocks",
            "validBlocks",
            "invalidBlocks",
            "retriedBlocks",
            "independentHeldOutFamilies",
            "minimumCompleteRepetitionsPerFamily",
            "blockLedger"
          ],
          "properties": {
            "enrolledBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "completedBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "validBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "invalidBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "retriedBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "independentHeldOutFamilies": { "type": "integer", "minimum": 0 },
            "minimumCompleteRepetitionsPerFamily": { "type": "integer", "minimum": 0 },
            "blockLedger": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "digest",
                "recordCount",
                "immutableReference",
                "invalidBlocks",
                "retries"
              ],
              "properties": {
                "digest": { "$ref": "#/$defs/digest" },
                "recordCount": { "$ref": "#/$defs/nonNegativeInteger" },
                "immutableReference": { "$ref": "#/$defs/nonEmptyString" },
                "invalidBlocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["blockId", "reason", "retainedOutcomeDigest"],
                    "properties": {
                      "blockId": { "$ref": "#/$defs/nonEmptyString" },
                      "reason": { "$ref": "#/$defs/nonEmptyString" },
                      "retainedOutcomeDigest": { "$ref": "#/$defs/digest" }
                    }
                  }
                },
                "retries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["blockId", "replacesBlockId", "retainedOutcomeDigest"],
                    "properties": {
                      "blockId": { "$ref": "#/$defs/nonEmptyString" },
                      "replacesBlockId": { "$ref": "#/$defs/nonEmptyString" },
                      "retainedOutcomeDigest": { "$ref": "#/$defs/digest" }
                    }
                  }
                }
              }
            }
          }
        },
        "outcomesByArm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/armOutcomes" }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preRandomizationSetupFailures",
            "replacementBlocks",
            "quarantinedWorkspaces",
            "cleanupFailures",
            "ledgerDigest",
            "immutableReference"
          ],
          "properties": {
            "preRandomizationSetupFailures": { "$ref": "#/$defs/nonNegativeInteger" },
            "replacementBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "quarantinedWorkspaces": { "$ref": "#/$defs/nonNegativeInteger" },
            "cleanupFailures": { "$ref": "#/$defs/nonNegativeInteger" },
            "ledgerDigest": { "$ref": "#/$defs/digest" },
            "immutableReference": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "aaEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "splitRole",
            "matchedBlocks",
            "pairedSuccessDisagreementRate",
            "setupFailureRate",
            "unknownRate",
            "evaluatorFailureRate",
            "upperSuccessNoiseBound",
            "latencyCoefficientOfVariation",
            "intraFamilyCorrelation",
            "orderEffectStatus",
            "estimateDigest"
          ],
          "properties": {
            "splitRole": { "const": "design-held-in" },
            "matchedBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "pairedSuccessDisagreementRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "setupFailureRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "unknownRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "evaluatorFailureRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "upperSuccessNoiseBound": { "type": "number", "minimum": 0, "maximum": 1 },
            "latencyCoefficientOfVariation": { "type": "number", "minimum": 0 },
            "intraFamilyCorrelation": { "type": "number", "minimum": -1, "maximum": 1 },
            "orderEffectStatus": { "enum": ["passed", "failed", "unknown"] },
            "estimateDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plannedPower",
            "achievedPower",
            "holmAdjustedAlpha",
            "familyWiseAlpha",
            "holmApplied",
            "pointEstimate",
            "decisionEffect",
            "adjustedIntervalLower",
            "adjustedIntervalUpper",
            "primaryIntervalExcludesZero",
            "effectMeetsDecisionEffect",
            "worstCaseMissingnessSensitivityPassed",
            "pairedDiscordanceRate",
            "intraFamilyCorrelation",
            "designEffect",
            "equalCaseWeighting",
            "clusteredPairedAnalysis"
          ],
          "properties": {
            "plannedPower": { "type": "number", "minimum": 0, "maximum": 1 },
            "achievedPower": { "type": "number", "minimum": 0, "maximum": 1 },
            "holmAdjustedAlpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
            "familyWiseAlpha": { "const": 0.05 },
            "holmApplied": { "type": "boolean" },
            "pointEstimate": { "type": "number", "minimum": -1, "maximum": 1 },
            "decisionEffect": { "type": "number", "minimum": 0.15, "maximum": 1 },
            "adjustedIntervalLower": { "type": "number", "minimum": -1, "maximum": 1 },
            "adjustedIntervalUpper": { "type": "number", "minimum": -1, "maximum": 1 },
            "primaryIntervalExcludesZero": { "type": "boolean" },
            "effectMeetsDecisionEffect": { "type": "boolean" },
            "worstCaseMissingnessSensitivityPassed": { "type": "boolean" },
            "pairedDiscordanceRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "intraFamilyCorrelation": { "type": "number", "minimum": -1, "maximum": 1 },
            "designEffect": { "type": "number", "minimum": 0 },
            "equalCaseWeighting": { "type": "boolean" },
            "clusteredPairedAnalysis": { "type": "boolean" }
          }
        },
        "multiplicity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "familyId",
            "method",
            "familyWiseAlpha",
            "alphaSpent",
            "queryLedgerDigest",
            "queryCount",
            "queryBudget",
            "allProposedSlicesReported",
            "droppedHypothesisIds",
            "results"
          ],
          "properties": {
            "familyId": { "$ref": "#/$defs/nonEmptyString" },
            "method": { "const": "holm" },
            "familyWiseAlpha": { "const": 0.05 },
            "alphaSpent": { "type": "number", "minimum": 0, "maximum": 0.05 },
            "queryLedgerDigest": { "$ref": "#/$defs/digest" },
            "queryCount": { "$ref": "#/$defs/nonNegativeInteger" },
            "queryBudget": { "type": "integer", "minimum": 1 },
            "allProposedSlicesReported": { "type": "boolean" },
            "droppedHypothesisIds": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "results": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/hypothesisResult" }
            }
          }
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protectedSuccess",
            "unknownRate",
            "timeoutRate",
            "evaluatorOrMissingRate",
            "meanCost",
            "totalTokens",
            "medianLatency",
            "p95Latency",
            "humanRubric"
          ],
          "properties": {
            "protectedSuccess": { "$ref": "#/$defs/gate" },
            "unknownRate": { "$ref": "#/$defs/gate" },
            "timeoutRate": { "$ref": "#/$defs/gate" },
            "evaluatorOrMissingRate": { "$ref": "#/$defs/gate" },
            "meanCost": { "$ref": "#/$defs/gate" },
            "totalTokens": { "$ref": "#/$defs/gate" },
            "medianLatency": { "$ref": "#/$defs/gate" },
            "p95Latency": { "$ref": "#/$defs/gate" },
            "humanRubric": { "$ref": "#/$defs/gate" }
          }
        },
        "executionDiagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "randomizationScheduleDigest",
            "freshEnvironmentPerArm",
            "freshFixtureMaterialization",
            "freshBookHome",
            "freshToolDiscoveryState",
            "freshProcessState",
            "balancedOrder",
            "interleavedOverTime",
            "boundedPairWindow",
            "wholeBlockRetriesOnly",
            "originalOutcomesRetained",
            "accountRegionLocked",
            "symmetricConcurrency",
            "cachePolicyBalanced",
            "rateLimitPolicyBalanced",
            "providerCacheStateRecorded",
            "pairWindowMaximumMs",
            "interleavedBlocks",
            "orderEffectStatus",
            "orderEffectEstimate",
            "armDiagnostics",
            "cacheDiagnosticsDigest",
            "rateLimitDiagnosticsDigest",
            "retryLedgerDigest",
            "concurrencyDiagnosticsDigest"
          ],
          "properties": {
            "randomizationScheduleDigest": { "$ref": "#/$defs/digest" },
            "freshEnvironmentPerArm": { "type": "boolean" },
            "freshFixtureMaterialization": { "type": "boolean" },
            "freshBookHome": { "type": "boolean" },
            "freshToolDiscoveryState": { "type": "boolean" },
            "freshProcessState": { "type": "boolean" },
            "balancedOrder": { "type": "boolean" },
            "interleavedOverTime": { "type": "boolean" },
            "boundedPairWindow": { "type": "boolean" },
            "wholeBlockRetriesOnly": { "type": "boolean" },
            "originalOutcomesRetained": { "type": "boolean" },
            "accountRegionLocked": { "type": "boolean" },
            "symmetricConcurrency": { "type": "boolean" },
            "cachePolicyBalanced": { "type": "boolean" },
            "rateLimitPolicyBalanced": { "type": "boolean" },
            "providerCacheStateRecorded": { "type": "boolean" },
            "pairWindowMaximumMs": { "type": "integer", "minimum": 1 },
            "interleavedBlocks": { "$ref": "#/$defs/nonNegativeInteger" },
            "orderEffectStatus": { "enum": ["passed", "failed", "unknown"] },
            "orderEffectEstimate": { "type": "number" },
            "armDiagnostics": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "armId",
                  "providerCacheHits",
                  "providerCacheMisses",
                  "throttledRequests",
                  "providerRetries",
                  "retryAfterMsTotal",
                  "rateLimitFailures",
                  "meanConcurrency",
                  "maxConcurrency",
                  "outputTruncations"
                ],
                "properties": {
                  "armId": { "$ref": "#/$defs/nonEmptyString" },
                  "providerCacheHits": { "$ref": "#/$defs/nonNegativeInteger" },
                  "providerCacheMisses": { "$ref": "#/$defs/nonNegativeInteger" },
                  "throttledRequests": { "$ref": "#/$defs/nonNegativeInteger" },
                  "providerRetries": { "$ref": "#/$defs/nonNegativeInteger" },
                  "retryAfterMsTotal": { "$ref": "#/$defs/nonNegativeInteger" },
                  "rateLimitFailures": { "$ref": "#/$defs/nonNegativeInteger" },
                  "meanConcurrency": { "type": "number", "minimum": 0 },
                  "maxConcurrency": { "type": "integer", "minimum": 1 },
                  "outputTruncations": { "$ref": "#/$defs/nonNegativeInteger" }
                }
              }
            },
            "cacheDiagnosticsDigest": { "$ref": "#/$defs/digest" },
            "rateLimitDiagnosticsDigest": { "$ref": "#/$defs/digest" },
            "retryLedgerDigest": { "$ref": "#/$defs/digest" },
            "concurrencyDiagnosticsDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "cellDigest", "components", "undeclaredDifferences"],
          "properties": {
            "valid": { "type": "boolean" },
            "cellDigest": { "$ref": "#/$defs/digest" },
            "components": {
              "type": "array",
              "minItems": 29,
              "items": { "$ref": "#/$defs/compatibilityComponent" }
            },
            "undeclaredDifferences": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preregistrationLocked",
            "sealedSplit",
            "queryLedgerValid",
            "sampleRatioValid",
            "leakageCheckPassed",
            "evaluatorAttestationVerified",
            "workerBrokerIsolationVerified",
            "machineVerifiersPassed",
            "humanRubricStatus",
            "cleanupPassed",
            "zeroToleranceViolationCount"
          ],
          "properties": {
            "preregistrationLocked": { "type": "boolean" },
            "sealedSplit": { "type": "boolean" },
            "queryLedgerValid": { "type": "boolean" },
            "sampleRatioValid": { "type": "boolean" },
            "leakageCheckPassed": { "type": "boolean" },
            "evaluatorAttestationVerified": { "type": "boolean" },
            "workerBrokerIsolationVerified": { "type": "boolean" },
            "machineVerifiersPassed": { "type": "boolean" },
            "humanRubricStatus": { "enum": ["passed", "failed", "unknown", "not-applicable"] },
            "cleanupPassed": { "type": "boolean" },
            "zeroToleranceViolationCount": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "attestations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluator", "workerHost", "broker", "finalSnapshot"],
          "properties": {
            "evaluator": { "$ref": "#/$defs/attestationReference" },
            "workerHost": { "$ref": "#/$defs/attestationReference" },
            "broker": { "$ref": "#/$defs/attestationReference" },
            "finalSnapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subjectDigest",
                "statementDigest",
                "signerId",
                "verified",
                "readOnly",
                "workerStopped",
                "descendantsStopped"
              ],
              "properties": {
                "subjectDigest": { "$ref": "#/$defs/digest" },
                "statementDigest": { "$ref": "#/$defs/digest" },
                "signerId": { "$ref": "#/$defs/nonEmptyString" },
                "verified": { "type": "boolean" },
                "readOnly": { "type": "boolean" },
                "workerStopped": { "type": "boolean" },
                "descendantsStopped": { "type": "boolean" }
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownerId",
            "approverId",
            "independentApprover",
            "approvedAt",
            "approvalDigest"
          ],
          "properties": {
            "ownerId": { "$ref": "#/$defs/nonEmptyString" },
            "approverId": { "$ref": "#/$defs/nonEmptyString" },
            "independentApprover": { "type": "boolean" },
            "approvedAt": { "type": "string", "format": "date-time" },
            "approvalDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "unsupportedSlices": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "evidenceStartedAt": { "type": "string", "format": "date-time" },
        "evidenceCompletedAt": { "type": "string", "format": "date-time" },
        "evidenceExpiresAt": { "type": "string", "format": "date-time" },
        "revalidationTriggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "rollbackTargetDigest": { "$ref": "#/$defs/digest" },
        "disposition": { "enum": ["promote", "reject", "insufficient-evidence"] },
        "dispositionReasons": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "promote" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "campaign": {
                "properties": {
                  "independentHeldOutFamilies": { "minimum": 20 },
                  "minimumCompleteRepetitionsPerFamily": { "minimum": 5 }
                }
              },
              "aaEvidence": {
                "properties": {
                  "matchedBlocks": { "minimum": 20 },
                  "orderEffectStatus": { "const": "passed" }
                }
              },
              "infrastructure": {
                "properties": { "cleanupFailures": { "const": 0 } }
              },
              "inference": {
                "properties": {
                  "plannedPower": { "minimum": 0.8 },
                  "achievedPower": { "minimum": 0.8 },
                  "holmApplied": { "const": true },
                  "primaryIntervalExcludesZero": { "const": true },
                  "effectMeetsDecisionEffect": { "const": true },
                  "worstCaseMissingnessSensitivityPassed": { "const": true },
                  "equalCaseWeighting": { "const": true },
                  "clusteredPairedAnalysis": { "const": true }
                }
              },
              "multiplicity": {
                "properties": {
                  "allProposedSlicesReported": { "const": true },
                  "droppedHypothesisIds": { "maxItems": 0 },
                  "results": {
                    "items": { "properties": { "status": { "const": "passed" } } }
                  }
                }
              },
              "guardrails": {
                "properties": {
                  "protectedSuccess": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": -0.05 } } }
                    ]
                  },
                  "unknownRate": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.02 } } }
                    ]
                  },
                  "timeoutRate": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.02 } } }
                    ]
                  },
                  "evaluatorOrMissingRate": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.02 } } }
                    ]
                  },
                  "meanCost": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.25 } } }
                    ]
                  },
                  "totalTokens": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.25 } } }
                    ]
                  },
                  "medianLatency": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.25 } } }
                    ]
                  },
                  "p95Latency": {
                    "allOf": [
                      { "$ref": "#/$defs/passedGate" },
                      { "properties": { "margin": { "const": 0.25 } } }
                    ]
                  },
                  "humanRubric": {
                    "oneOf": [
                      {
                        "allOf": [
                          { "$ref": "#/$defs/passedGate" },
                          { "properties": { "margin": { "const": -0.25 } } }
                        ]
                      },
                      {
                        "allOf": [
                          { "$ref": "#/$defs/gate" },
                          {
                            "properties": {
                              "status": { "const": "not-applicable" },
                              "margin": { "const": -0.25 }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              "executionDiagnostics": {
                "properties": {
                  "freshEnvironmentPerArm": { "const": true },
                  "freshFixtureMaterialization": { "const": true },
                  "freshBookHome": { "const": true },
                  "freshToolDiscoveryState": { "const": true },
                  "freshProcessState": { "const": true },
                  "balancedOrder": { "const": true },
                  "interleavedOverTime": { "const": true },
                  "boundedPairWindow": { "const": true },
                  "wholeBlockRetriesOnly": { "const": true },
                  "originalOutcomesRetained": { "const": true },
                  "accountRegionLocked": { "const": true },
                  "symmetricConcurrency": { "const": true },
                  "cachePolicyBalanced": { "const": true },
                  "rateLimitPolicyBalanced": { "const": true },
                  "providerCacheStateRecorded": { "const": true },
                  "orderEffectStatus": { "const": "passed" }
                }
              },
              "compatibility": {
                "properties": {
                  "valid": { "const": true },
                  "undeclaredDifferences": { "maxItems": 0 }
                }
              },
              "integrity": {
                "properties": {
                  "preregistrationLocked": { "const": true },
                  "sealedSplit": { "const": true },
                  "queryLedgerValid": { "const": true },
                  "sampleRatioValid": { "const": true },
                  "leakageCheckPassed": { "const": true },
                  "evaluatorAttestationVerified": { "const": true },
                  "workerBrokerIsolationVerified": { "const": true },
                  "machineVerifiersPassed": { "const": true },
                  "humanRubricStatus": { "enum": ["passed", "not-applicable"] },
                  "cleanupPassed": { "const": true },
                  "zeroToleranceViolationCount": { "const": 0 }
                }
              },
              "attestations": {
                "properties": {
                  "evaluator": { "properties": { "verified": { "const": true } } },
                  "workerHost": { "properties": { "verified": { "const": true } } },
                  "broker": { "properties": { "verified": { "const": true } } },
                  "finalSnapshot": {
                    "properties": {
                      "verified": { "const": true },
                      "readOnly": { "const": true },
                      "workerStopped": { "const": true },
                      "descendantsStopped": { "const": true }
                    }
                  }
                }
              },
              "approval": {
                "properties": { "independentApprover": { "const": true } }
              }
            }
          }
        }
      ]
    }
  }
}
